#: src/Admin/PluginMeta.php:58
msgid "More information about CBC Wine Menu"
msgstr "Ulteriori informazioni su CBC Wine Menu"

#: src/Admin/PluginMeta.php:90
msgid "Restaurant staff manage wines, glasses, drinks and beers from WordPress Admin. Guests scan a permanent table QR code, receive a 30-minute session, and browse the mobile-first menu in Italian or English."
msgstr "Lo staff gestisce vini, calici, drink e birre da WordPress Admin. Gli ospiti scansionano il QR permanente del tavolo, ricevono una sessione di 30 minuti e consultano il menu mobile-first in italiano o inglese."

#: src/Admin/PluginMeta.php:95
msgid "Copy the plugin folder into wp-content/plugins/."
msgstr "Copia la cartella del plugin in wp-content/plugins/."

#: src/Admin/PluginMeta.php:96
msgid "Activate CBC Wine Menu from Plugins."
msgstr "Attiva CBC Wine Menu dalla pagina Plugin."

#: src/Admin/PluginMeta.php:97
msgid "Add or import wines, then configure footer and restaurant social links under Settings → CBC Wine Menu."
msgstr "Aggiungi o importa i vini, poi configura footer e social del locale in Impostazioni → CBC Wine Menu."
